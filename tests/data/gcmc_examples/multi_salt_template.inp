# Water + NaCl mixture with CBMC/cavity (CHARMM / gcmc_gpu-style units)
par:{DATA_DIR}/charmm36.ff/ffnonbonded.itp
atomtypes:{DATA_DIR}/charmm36.ff/atomtypes.atp
top:{DATA_DIR}/gcmc_examples/empty.top
pdb:{DATA_DIR}/gcmc_examples/empty.pdb
protitp:{DATA_DIR}/gcmc_examples/empty.top

box: 30.0 30.0 30.0
temperature: 298.0
cutoff: 14.0

use_conf_bias: yes
fragconf: 5
use_cavity_bias: yes
cavity_grid_dx: 2.0
cavity_probe_radius: 1.4

fragname: WAT
fragconc: 55.5
fragmuex: -5.60
mctime: 0.8
fragitp:{DATA_DIR}/mols/sol.itp

fragname: NA
fragconc: 0.15
fragmuex: -12.0
mctime: 0.1
fragitp:{DATA_DIR}/charmm36.ff/mol/na.itp

fragname: CL
fragconc: 0.15
fragmuex: -11.5
mctime: 0.1
fragitp:{DATA_DIR}/charmm36.ff/mol/cl.itp

mcsteps: 1500
moves_per_step: 1
nprint: 500
eqsteps: 100
mc_move_prob: 0.5 0.5 0 0

seed: 20240502
