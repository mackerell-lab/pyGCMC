#ifdef POSRES
#include "posre.itp"
#endif

; Include C-alpha positional restraints file
#ifdef POSRE_CA
#include "posre_protein_ca.itp"
#endif

; Include silcs molecules
 #include "./charmm36.ff/mol/benx.itp"
 #include "./charmm36.ff/mol/prpx.itp"
 #include "./charmm36.ff/mol/dmee.itp"
 #include "./charmm36.ff/mol/meoh.itp"
 #include "./charmm36.ff/mol/form.itp"
 #include "./charmm36.ff/mol/imia.itp"
 #include "./charmm36.ff/mol/acey.itp"
 #include "./charmm36.ff/mol/mamy.itp"

; Include water topology
#include "./charmm36.ff/tip3p.itp"

#ifdef POSRES_WATER
; Position restraint for each water oxygen
[ position_restraints ]
;  i funct       fcx        fcy        fcz
   1    1       1000       1000       1000
#endif

; Include topology for ions
#include "./charmm36.ff/ions.itp"

[ system ]
; Name
Protein in water

